#ifndef CONFIG_H
#define CONFIG_H

// WiFi Configuration
#define WIFI_SSID "SSID"
#define WIFI_PASSWORD "PASS"

// SMTP Configuration (Gmail)
#define SMTP_HOST "smtp.gmail.com"
#define SMTP_PORT 465
#define SMTP_USER "sender@gmail.com"
#define SMTP_PASSWORD "PASSWORD"  // Gmail App Password

// Email Configuration
#define EMAIL_RECIPIENT "recipient@gmail.com"
#define EMAIL_SUBJECT_PREFIX "[Printer]"

// Optional settings (defaults shown)

// POSIX TZ string for the Date header and subjects, e.g. "EET-2EEST,M3.5.0/3,M10.5.0/4" for Athens
// #define TIMEZONE "UTC0"

// Character set the printer data uses for bytes >= 0x80. Leave undefined to pass
// them through unchanged (ASCII or UTF-8 data). Options: CODEPAGE_CP437,
// CODEPAGE_CP737 (DOS Greek), CODEPAGE_CP850, CODEPAGE_CP1252, CODEPAGE_CP1253,
// CODEPAGE_ISO8859_7
// #define PRINTER_CODEPAGE CODEPAGE_CP437

// Attach the raw job to every email. By default it is attached only when the
// body can't show it in full (control codes stripped, or preview truncated).
// #define EMAIL_ALWAYS_ATTACH_RAW 1

// Largest email body preview in bytes; longer jobs are truncated in the body and attached
// #define EMAIL_BODY_MAX_BYTES (16 * 1024)

// GPIO of the on-board RGB status LED
// #define PIN_STATUS_LED 38

// Skip SMTP server certificate verification. Not recommended: anyone on the
// network path could read the SMTP password. Only use if NTP is blocked.
// #define SMTP_TLS_INSECURE

// Debugging
// #define SEND_TEST_EMAIL_ON_BOOT

#endif  // CONFIG_H
